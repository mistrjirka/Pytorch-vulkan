#version 450
// FP32 batched matrix multiply with independent strides for each batch.
// 16x16 shared tile, compatible with (B,M,K)@(B,K,N) and transposed views.
layout(local_size_x=16,local_size_y=16,local_size_z=1) in;
layout(set=0,binding=0) readonly buffer A {float a[];};
layout(set=0,binding=1) readonly buffer B {float b[];};
layout(set=0,binding=2) writeonly buffer C {float out_data[];};
layout(push_constant) uniform Params {
  uint batch,m,k,n,offset_a,offset_b;
  uint a0,a1,a2,b0,b1,b2;
} p;
shared float ta[16][16],tb[16][16];
void main(){
  uint batch=gl_WorkGroupID.z;
  uint row=gl_WorkGroupID.y*16u+gl_LocalInvocationID.y;
  uint col=gl_WorkGroupID.x*16u+gl_LocalInvocationID.x;
  uint lx=gl_LocalInvocationID.x,ly=gl_LocalInvocationID.y;
  if(batch>=p.batch)return;
  float sum=0.0;
  for(uint k0=0u;k0<p.k;k0+=16u) {
    uint ak=k0+lx,bk=k0+ly;
    ta[ly][lx]=(row<p.m && ak<p.k) ?
      a[p.offset_a+batch*p.a0+row*p.a1+ak*p.a2]:0.0;
    tb[ly][lx]=(col<p.n && bk<p.k) ?
      b[p.offset_b+batch*p.b0+bk*p.b1+col*p.b2]:0.0;
    barrier();
    for(uint i=0u;i<16u;++i)sum+=ta[ly][i]*tb[i][lx];
    barrier();
  }
  if(row<p.m && col<p.n)out_data[(batch*p.m+row)*p.n+col]=sum;
}
