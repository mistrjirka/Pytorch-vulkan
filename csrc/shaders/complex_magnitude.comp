#version 450
#extension GL_GOOGLE_include_directive : require
#include "fp32_math.glsl"
#include "fp32_norm.glsl"
layout(local_size_x=128) in;
layout(binding=0) readonly buffer X {vec2 x[];};
layout(binding=1) writeonly buffer Y {float y[];};
layout(push_constant) uniform P {uint count;}p;
void main(){uint i=(gl_WorkGroupID.x+gl_WorkGroupID.y*gl_NumWorkGroups.x)*128+gl_LocalInvocationID.x;if(i>=p.count)return;y[i]=portable_hypot(x[i].x,x[i].y);}
