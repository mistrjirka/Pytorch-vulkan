#version 450
layout(local_size_x = 128) in;
layout(set = 0, binding = 0) readonly buffer GradOut { float grad_out[]; };
layout(set = 0, binding = 1) writeonly buffer GradBias { float grad_bias[]; };
layout(push_constant) uniform Params {
    uint n, cin, cout, h, w, kh, kw, oh, ow;
    uint sh, sw, ph, pw, dh, dw, groups;
} p;
void main() {
    // Flatten a two-dimensional dispatch; reject padded groups before the
    // element-index multiplication so near-uint32-limit tensors cannot wrap.
    uint output_count = p.cout;
    uint group_index = gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x;
    if (group_index >= output_count/128 + uint(output_count%128 != 0)) return;
    uint oc = (group_index*128+gl_LocalInvocationID.x);
    if (oc >= p.cout) return;
    float sum = 0.0;
    for (uint batch = 0; batch < p.n; ++batch) {
        for (uint oh = 0; oh < p.oh; ++oh) {
            for (uint ow = 0; ow < p.ow; ++ow) {
                uint idx = ((batch * p.cout + oc) * p.oh + oh) * p.ow + ow;
                sum += grad_out[idx];
            }
        }
    }
    grad_bias[oc] = sum;
}
