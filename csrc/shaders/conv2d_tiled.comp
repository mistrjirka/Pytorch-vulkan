#version 450

// Generic tiled implicit-GEMM FP32 NCHW Conv2D. It avoids a full im2col
// temporary: input elements are gathered into workgroup shared memory on
// demand. Workgroups never cross convolution groups.
layout(local_size_x=16,local_size_y=8,local_size_z=1) in;
layout(set=0,binding=0) readonly buffer Input { float x[]; };
layout(set=0,binding=1) readonly buffer Weight { float w[]; };
layout(set=0,binding=2) readonly buffer Bias { float bias[]; };
layout(set=0,binding=3) writeonly buffer Output { float y[]; };

layout(push_constant) uniform Params {
  uint n,cin,cout,h,w,kh,kw,oh,ow;
  uint sh,sw,ph,pw,dh,dw,groups;
} p;

const uint TM=8;
const uint TN=16;
const uint TK=16;
shared float a_tile[TM*TK];
shared float b_tile[TK*TN];

void main() {
  uint lx=gl_LocalInvocationID.x;
  uint ly=gl_LocalInvocationID.y;
  uint group_channels=p.cout / p.groups;
  uint in_channels=p.cin / p.groups;
  uint tiles_per_group=(group_channels + TM-1)/TM;
  uint group=gl_WorkGroupID.y / tiles_per_group;
  uint m_in_group=(gl_WorkGroupID.y % tiles_per_group)*TM+ly;
  uint oc=group*group_channels+m_in_group;
  uint spatial=gl_WorkGroupID.x*TN+lx;
  uint size_n=p.n*p.oh*p.ow;
  uint ktotal=in_channels*p.kh*p.kw;
  bool valid_m=m_in_group<group_channels;
  bool valid_n=spatial<size_n;
  float acc=0.0;

  for (uint k0=0; k0<ktotal; k0+=TK) {
    uint ak=k0+lx;
    uint aindex=ly*TK+lx;
    if (valid_m && ak<ktotal) {
      uint inch=ak/(p.kh*p.kw);
      uint rem=ak%(p.kh*p.kw);
      uint kh=rem/p.kw, kw=rem%p.kw;
      a_tile[aindex]=w[((oc*in_channels+inch)*p.kh+kh)*p.kw+kw];
    } else {
      a_tile[aindex]=0.0;
    }

    uint batch=spatial/(p.oh*p.ow);
    uint pos=spatial%(p.oh*p.ow);
    uint oy=pos/p.ow, ox=pos%p.ow;
    for (uint r=0; r<2; ++r) {
      uint bk=k0+r*8+ly;
      float v=0.0;
      if (valid_n && bk<ktotal) {
        uint inch=group*in_channels+bk/(p.kh*p.kw);
        uint rem=bk%(p.kh*p.kw);
        uint ky=rem/p.kw, kx=rem%p.kw;
        int iy=int(oy*p.sh) - int(p.ph) + int(ky*p.dh);
        int ix=int(ox*p.sw) - int(p.pw) + int(kx*p.dw);
        if (iy>=0 && iy<int(p.h) && ix>=0 && ix<int(p.w)) {
          v=x[((batch*p.cin+inch)*p.h+uint(iy))*p.w+uint(ix)];
        }
      }
      b_tile[(r*8+ly)*TN+lx]=v;
    }
    barrier();
    for (uint kk=0;kk<TK;++kk) {
      acc+=a_tile[ly*TK+kk]*b_tile[kk*TN+lx];
    }
    barrier();
  }
  if (valid_m && valid_n) {
    uint batch=spatial/(p.oh*p.ow);
    uint position=spatial%(p.oh*p.ow);
    y[(batch*p.cout+oc)*p.oh*p.ow+position]=acc+bias[oc];
  }
}
