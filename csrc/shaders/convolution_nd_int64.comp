#version 450
#extension GL_GOOGLE_include_directive : require
#include "integer64_math.glsl"
layout(local_size_x=128) in;
layout(binding=0) readonly buffer X {uvec2 x[];};
layout(binding=1) readonly buffer W {uvec2 w[];};
layout(binding=2) readonly buffer B {uvec2 b[];};
layout(binding=3) writeonly buffer Y {uvec2 y[];};
layout(push_constant) uniform Params {uint n,ci,co,groups;uint ins[3],outs[3],ks[3],stride[3],pad[3],dilation[3];uint transposed,mode,count,bias,reserved;} p;
uint volume(uint s[3]){return s[0]*s[1]*s[2];}
ivec3 decode(uint i,uint s[3]){return ivec3(i/(s[1]*s[2]),i/s[2]%s[1],i%s[2]);}
uint encode(ivec3 i,uint s[3]){return (uint(i.x)*s[1]+uint(i.y))*s[2]+uint(i.z);}
bool map_coord(ivec3 pos,ivec3 k,bool inverse,out ivec3 target,uint bounds[3]){
 for(int d=0;d<3;d++){
  int v=inverse?pos[d]+int(p.pad[d])-k[d]*int(p.dilation[d]):pos[d]*int(p.stride[d])-int(p.pad[d])+k[d]*int(p.dilation[d]);
  if(inverse){if(v<0||v%int(p.stride[d])!=0)return false;v/=int(p.stride[d]);}
  if(v<0||v>=int(bounds[d]))return false;target[d]=v;
 }
 return true;
}
uint wi(uint ci,uint co,uint k,uint kv){return p.transposed!=0?(ci*(p.co/p.groups)+co%(p.co/p.groups))*kv+k:(co*(p.ci/p.groups)+ci%(p.ci/p.groups))*kv+k;}
void main(){
 uint id=(gl_WorkGroupID.x+gl_WorkGroupID.y*gl_NumWorkGroups.x)*128u+gl_LocalInvocationID.x;if(id>=p.count)return;
 uint iv=volume(p.ins),ov=volume(p.outs),kv=volume(p.ks),icg=p.ci/p.groups,ocg=p.co/p.groups;
 uint co=id/ov%p.co,n=id/(ov*p.co);ivec3 o=decode(id%ov,p.outs);uint group=co/ocg;
 uvec2 sum=p.bias!=0u?b[co]:uvec2(0u);
 for(uint ci=group*icg;ci<(group+1u)*icg;ci++)for(uint k=0u;k<kv;k++){
  ivec3 i;if(map_coord(o,decode(k,p.ks),p.transposed!=0u,i,p.ins))sum=plus64(sum,times64(x[(n*p.ci+ci)*iv+encode(i,p.ins)],w[wi(ci,co,k,kv)]));
 }
 y[id]=sum;
}
