void main(){uint i=(gl_WorkGroupID.x+gl_WorkGroupID.y*gl_NumWorkGroups.x)*128+gl_LocalInvocationID.x;if(i>=p.count)return;
 uint j=i/p.inner%p.n,outer=i/(p.n*p.inner),tail=i%p.inner,k=p.logn==0?0:bitfieldReverse(j)>>(32-p.logn);bool conjugate=p.mode==2&&k>=p.input_n;uint src=(outer*p.input_n+(conjugate?p.n-k:k))*p.inner+tail;
