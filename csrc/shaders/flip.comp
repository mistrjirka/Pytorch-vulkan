#version 450
layout(local_size_x=128) in;
layout(binding=0) readonly buffer X {uint x[];};
layout(binding=1) writeonly buffer Y {uint y[];};
layout(push_constant) uniform P {uint count,mask,words;uint dims[8];} p;
void main(){uint i=(gl_WorkGroupID.x+gl_WorkGroupID.y*gl_NumWorkGroups.x)*128+gl_LocalInvocationID.x;if(i>=p.count)return;uint r=i,address=0,stride=1;for(int d=7;d>=0;d--){uint c=r%p.dims[d];r/=p.dims[d];if((p.mask&(1u<<d))!=0)c=p.dims[d]-1-c;address+=c*stride;stride*=p.dims[d];}for(uint k=0;k<p.words;k++)y[i*p.words+k]=x[address*p.words+k];}
