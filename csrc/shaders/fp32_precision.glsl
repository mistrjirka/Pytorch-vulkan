// Original portable FP32 refinements. Two-float intermediates avoid a shader
// float64 or fused-FMA requirement while rounding inverse trig to binary32.
vec2 fp_two_sum(float a,float b){precise float s=a+b;precise float v=s-a;precise float e=(a-(s-v))+(b-v);return vec2(s,e);}
vec2 fp_two_product(float a,float b){precise float p=a*b;float ah=uintBitsToFloat(floatBitsToUint(a)&0xfffff000u),bh=uintBitsToFloat(floatBitsToUint(b)&0xfffff000u);precise float al=a-ah,bl=b-bh;precise float e=((ah*bh-p)+ah*bl+al*bh)+al*bl;return vec2(p,e);}
vec2 fp_dd_add(vec2 a,vec2 b){vec2 s=fp_two_sum(a.x,b.x);precise float e=s.y+a.y+b.y;return fp_two_sum(s.x,e);}
vec2 fp_dd_mul(vec2 a,vec2 b){vec2 p=fp_two_product(a.x,b.x);precise float e=p.y+a.x*b.y+a.y*b.x;return fp_two_sum(p.x,e);}
