#version 450
layout(local_size_x=128) in;
layout(binding=0) readonly buffer X {float x[];};
layout(binding=1) readonly buffer I {uint idx[];};
layout(binding=2) readonly buffer S {float src[];};
layout(binding=3) writeonly buffer Y {float y[];};
layout(push_constant) uniform P {uint count,mode,axis,rank,words,value;uint xs[8],is[8];}p;
void main(){
 uint id=(gl_WorkGroupID.x+gl_WorkGroupID.y*gl_NumWorkGroups.x)*128+gl_LocalInvocationID.x;if(id>=p.count)return;
 uint coords[8],r=id;for(int d=7;d>=0;d--){uint size=p.mode==0?p.is[d]:p.xs[d];coords[d]=r%size;r/=size;}
 if(p.mode==0){coords[p.axis]=idx[id*p.words];uint address=0;for(int d=0;d<8;d++)address=address*p.xs[d]+coords[d];y[id]=x[address];return;}
 float result=x[id];bool within=true,found=false,include=uintBitsToFloat(p.value)!=0;uint count=include?1:0;
 for(uint d=0;d<8;d++)if(d!=p.axis&&coords[d]>=p.is[d])within=false;
 if(within){uint wanted=coords[p.axis];for(uint k=0;k<p.is[p.axis];k++){coords[p.axis]=k;uint address=0;for(int d=0;d<8;d++)address=address*p.is[d]+coords[d];
  if(idx[address*p.words]!=wanted)continue;float v=p.mode==3?uintBitsToFloat(p.value):src[address];
  if(p.mode>=4&&!include&&!found)result=p.mode==5?1:p.mode==7?-uintBitsToFloat(0x7f800000u):p.mode==8?uintBitsToFloat(0x7f800000u):0;
  found=true;count++;
  if(p.mode==1||p.mode==4||p.mode==6)result+=v;
  else if(p.mode==5)result*=v;
  else if(p.mode==7||p.mode==8)result=isnan(result)||isnan(v)?uintBitsToFloat(0x7fc00000u):p.mode==7?max(result,v):min(result,v);
  else result=v;
 }}
 if(p.mode==6&&found)result/=float(count);y[id]=result;
}
