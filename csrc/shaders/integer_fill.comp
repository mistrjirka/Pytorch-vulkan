#version 450
layout(local_size_x=128) in;
layout(binding=0) buffer X {uint x[];};
layout(binding=1) buffer Y {uint y[];};
layout(push_constant) uniform P {uint count,offset,words,lo,hi;uint sizes[8],strides[8];} p;
void main(){uint i=(gl_WorkGroupID.x+gl_WorkGroupID.y*gl_NumWorkGroups.x)*128+gl_LocalInvocationID.x;if(i>=p.count)return;uint r=i,address=p.offset;for(int d=7;d>=0;d--){address+=(r%p.sizes[d])*p.strides[d];r/=p.sizes[d];}y[address*p.words]=p.lo;if(p.words==2)y[address*2+1]=p.hi;}
