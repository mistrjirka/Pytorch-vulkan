layout(binding=0) readonly buffer Input {float input_data[];};layout(binding=1) buffer LD {float ld[];};layout(binding=2) buffer Pivots {int pivots[];};layout(binding=3) buffer Info {int info[];};layout(binding=4) buffer Workspace {float schur[];};
layout(push_constant) uniform P {uint batch,n,alpha;}p;
shared uint pivot,step_size,skip_update;
void sync_buffers(){memoryBarrierBuffer();barrier();}
void main(){uint batch=gl_WorkGroupID.x+gl_WorkGroupID.y*gl_NumWorkGroups.x,lane=gl_LocalInvocationID.x;if(batch>=p.batch)return;uint n=p.n,base=batch*n*n;float alpha=uintBitsToFloat(p.alpha);
 for(uint i=lane;i<n*n;i+=128u){uint row=i/n,col=i%n;ld[base+i]=row>=col?input_data[base+i]:0.0;schur[base+i]=input_data[base+max(row,col)*n+min(row,col)];}if(lane==0u)info[batch]=0;sync_buffers();
 for(uint k=0u;k<n;){if(lane==0u){step_size=1u;pivot=k;skip_update=0u;float diagonal=abs(schur[base+k*n+k]),column_max=0.0;uint imax=k;for(uint i=k+1u;i<n;i++){float value=abs(schur[base+i*n+k]);if(value>column_max){column_max=value;imax=i;}}
  if(max(diagonal,column_max)==0.0||isnan(diagonal)){skip_update=1u;if(info[batch]==0)info[batch]=int(k+1u);}else if(diagonal<alpha*column_max){float row_max=0.0;for(uint j=k;j<n;j++)if(j!=imax)row_max=max(row_max,abs(schur[base+imax*n+j]));precise float test=alpha*column_max*divide_refined(column_max,row_max);if(diagonal>=test)pivot=k;else if(abs(schur[base+imax*n+imax])>=alpha*row_max)pivot=imax;else{pivot=imax;step_size=2u;}}}
