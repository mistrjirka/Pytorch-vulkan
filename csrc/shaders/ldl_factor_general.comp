  if(lane==0u){ld[base+k*n+k]=schur[base+k*n+k];pivots[batch*n+k]=block_size==1u?int(kp+1u):-int(kp+1u);if(block_size==2u){ld[base+(k+1u)*n+k+1u]=schur[base+(k+1u)*n+k+1u];ld[base+(k+1u)*n+k]=schur[base+(k+1u)*n+k];pivots[batch*n+k+1u]=-int(kp+1u);}}
  for(uint i=k+block_size+lane;i<n;i+=128u){float a=schur[base+i*n+k];if(skip_update!=0u)ld[base+i*n+k]=a;else if(block_size==1u)ld[base+i*n+k]=a*divide_refined(1.0,schur[base+k*n+k]);else{float off=schur[base+(k+1u)*n+k],d11=divide_refined(schur[base+(k+1u)*n+k+1u],off),d22=divide_refined(schur[base+k*n+k],off);precise float denominator=d11*d22-1.0;float scale=divide_refined(divide_refined(1.0,denominator),off),b=schur[base+i*n+k+1u];precise float first=scale*(d11*a-b),second=scale*(d22*b-a);ld[base+i*n+k]=first;ld[base+i*n+k+1u]=second;}}sync_buffers();
  if(skip_update==0u)for(uint index=lane;index<n*n;index+=128u){uint i=index/n,j=index%n;if(i<k+block_size||j<k+block_size||i<j)continue;precise float value=schur[base+index]-schur[base+i*n+k]*ld[base+j*n+k];if(block_size==2u)value-=schur[base+i*n+k+1u]*ld[base+j*n+k+1u];schur[base+index]=value;schur[base+j*n+i]=value;}sync_buffers();k+=block_size;
 }
}
