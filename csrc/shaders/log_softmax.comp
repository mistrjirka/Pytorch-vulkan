#version 450
// Numerically stable row-wise FP32 log-softmax.
layout(local_size_x=256) in;
layout(set=0,binding=0) readonly buffer Input { float input_data[]; };
layout(set=0,binding=1) writeonly buffer Output { float output_data[]; };
layout(push_constant) uniform Shape { uint rows; uint cols; } p;

shared float max_values[256];
shared float exp_sums[256];

void main() {
    uint row=gl_WorkGroupID.x;
    uint tid=gl_LocalInvocationID.x;
    if (row>=p.rows) return;
    uint base=row*p.cols;
    float local_max=-3.402823466e38;
    for (uint c=tid;c<p.cols;c+=256)
        local_max=max(local_max,input_data[base+c]);
    max_values[tid]=local_max;
    barrier();
    for(uint step=128;step>0;step>>=1) {
        if(tid<step) max_values[tid]=max(max_values[tid],max_values[tid+step]);
        barrier();
    }
    float maxval=max_values[0];
    float local_sum=0.0;
    for(uint c=tid;c<p.cols;c+=256)
        local_sum+=exp(input_data[base+c]-maxval);
    exp_sums[tid]=local_sum;
    barrier();
    for(uint step=128;step>0;step>>=1) {
        if(tid<step) exp_sums[tid]+=exp_sums[tid+step];
        barrier();
    }
    float denom_log=log(exp_sums[0]);
    for(uint c=tid;c<p.cols;c+=256)
        output_data[base+c]=(input_data[base+c]-maxval)-denom_log;
}
