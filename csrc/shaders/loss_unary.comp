#version 450
#extension GL_GOOGLE_include_directive : require
#include "fp32_math.glsl"
layout(local_size_x=128) in;
layout(set=0,binding=0) readonly buffer Input { float x[]; };
layout(set=0,binding=1) writeonly buffer Output { float y[]; };
layout(push_constant) uniform Params {uint count,offset,op;float scalar;uint dims[8];uint strides[8];} p;
void main(){
  uint group=gl_WorkGroupID.x+gl_WorkGroupID.y*gl_NumWorkGroups.x;
  if(group>=(p.count-1u)/128u+1u)return;
  uint i=group*128+gl_LocalInvocationID.x;
  if(i>=p.count)return;
  uint r=i,a=p.offset;
  for(int d=7;d>=0;--d){a+=(r%p.dims[d])*p.strides[d];r/=p.dims[d];}
  float v=x[a];
  if(p.op==0)y[i]=1.0/(1.0+exp(-v));
  else if(p.op==1)y[i]=abs(v);
  // Ordered comparisons on NaN must not produce a positive/negative sign.
  // Handle it explicitly: PyTorch sgn(NaN) is zero for real FP32 tensors.
  else if(p.op==2)y[i]=isnan(v) ? 0.0 : (float(v>0)-float(v<0));
  else y[i]=divide_refined(v,p.scalar);
}
