#version 450
layout(local_size_x=128) in;
layout(binding=0) readonly buffer L {float lu[];};
layout(binding=1) readonly buffer Piv {int piv[];};
layout(binding=2) readonly buffer B {float b[];};
layout(binding=3) buffer X {float x[];};
layout(push_constant) uniform P {uint batch,n,cols,transpose;} p;
void main(){uint id=(gl_WorkGroupID.x+gl_WorkGroupID.y*gl_NumWorkGroups.x)*128+gl_LocalInvocationID.x;if(id>=p.batch*p.cols)return;uint batch=id/p.cols,col=id%p.cols,lb=batch*p.n*p.n,base=batch*p.n*p.cols+col;
 for(uint r=0;r<p.n;r++)x[base+r*p.cols]=b[base+r*p.cols];
 if(p.transpose==0){
  for(uint k=0;k<p.n;k++){uint r=uint(piv[batch*p.n+k]-1);float temp=x[base+k*p.cols];x[base+k*p.cols]=x[base+r*p.cols];x[base+r*p.cols]=temp;}
  for(uint r=0;r<p.n;r++){float v=x[base+r*p.cols];for(uint k=0;k<r;k++)v-=lu[lb+r*p.n+k]*x[base+k*p.cols];x[base+r*p.cols]=v;}
  for(int r=int(p.n)-1;r>=0;r--){float v=x[base+uint(r)*p.cols];for(uint k=uint(r)+1;k<p.n;k++)v-=lu[lb+uint(r)*p.n+k]*x[base+k*p.cols];x[base+uint(r)*p.cols]=v/lu[lb+uint(r)*p.n+uint(r)];}
 }else{
  for(uint r=0;r<p.n;r++){float v=x[base+r*p.cols];for(uint k=0;k<r;k++)v-=lu[lb+k*p.n+r]*x[base+k*p.cols];x[base+r*p.cols]=v/lu[lb+r*p.n+r];}
  for(int r=int(p.n)-1;r>=0;r--){float v=x[base+uint(r)*p.cols];for(uint k=uint(r)+1;k<p.n;k++)v-=lu[lb+k*p.n+uint(r)]*x[base+k*p.cols];x[base+uint(r)*p.cols]=v;}
  for(int k=int(p.n)-1;k>=0;k--){uint r=uint(piv[batch*p.n+uint(k)]-1);float temp=x[base+uint(k)*p.cols];x[base+uint(k)*p.cols]=x[base+r*p.cols];x[base+r*p.cols]=temp;}
 }
}
