#version 450
#extension GL_GOOGLE_include_directive : require
#include "fp32_math.glsl"
layout(local_size_x=128) in;
layout(binding=0) readonly buffer X{float x[];};layout(binding=1) readonly buffer T{uvec2 target[];};layout(binding=2) readonly buffer W{float weight[];};layout(binding=3) readonly buffer G{float grad[];};layout(binding=4) readonly buffer M{float mask[];};layout(binding=5) writeonly buffer Y{float y[];};layout(binding=6) buffer O{float is_target[];};
layout(push_constant) uniform P{uint count,rows,classes,mode,power,margin_bits,weighted,reduction,grad_scalar;}p;
void main(){uint i=(gl_WorkGroupID.x+gl_WorkGroupID.y*gl_NumWorkGroups.x)*128u+gl_LocalInvocationID.x;if(i>=p.count)return;bool backward=(p.mode&1u)!=0u,multi=p.mode<2u;uint row=backward?i/p.classes:i,c=backward?i%p.classes:0u,base=row*p.classes;
 if(multi){uint label=target[row].x;float value=x[base+label],w=p.weighted!=0u?weight[label]:1.,margin=uintBitsToFloat(p.margin_bits);precise float sum=0.;if(!backward||c==label){for(uint j=0u;j<p.classes;j++)if(j!=label){precise float z=margin-value;z+=x[base+j];if(z>0.)sum+=backward?(p.power==1u?1.:2.*z)*w:(p.power==1u?z:z*z)*w;}sum=divide_refined(sum,float(p.classes));if(backward)sum=-sum;}else{precise float z=margin-value;z+=x[base+c];sum=z>0.?divide_refined((p.power==1u?1.:2.*z)*w,float(p.classes)):0.;}if(backward){if(p.reduction==1u)sum=divide_refined(sum,float(p.rows));sum*=grad[p.grad_scalar!=0u?0u:row];}y[i]=sum;return;}
 if(!backward){for(uint j=0u;j<p.classes;j++)is_target[base+j]=0.;for(uint k=0u;k<p.classes;k++){uvec2 label=target[base+k];if(int(label.y)<0)break;is_target[base+label.x]=1.;}precise float sum=0.,correction=0.;for(uint k=0u;k<p.classes;k++){uvec2 label=target[base+k];if(int(label.y)<0)break;for(uint j=0u;j<p.classes;j++)if(is_target[base+j]==0.){precise float z=1.-x[base+label.x];z+=x[base+j];if(z>0.){precise float next=sum+z;correction+=abs(sum)>=abs(z)?(sum-next)+z:(z-next)+sum;sum=next;}}}y[i]=divide_refined(sum+correction,float(p.classes));return;}
 precise float value=0.;float factor=divide_refined(1.,float(p.classes)*(p.reduction==1u?float(p.rows):1.));for(uint k=0u;k<p.classes;k++){uvec2 label=target[base+k];if(int(label.y)<0)break;if(c==label.x){for(uint j=0u;j<p.classes;j++)if(mask[base+j]==0.){precise float z=1.-x[base+label.x];z+=x[base+j];if(z>0.)value-=factor;}}else if(mask[base+c]==0.){precise float z=1.-x[base+label.x];z+=x[base+c];if(z>0.)value+=factor;}}
 y[i]=value*grad[p.grad_scalar!=0u?0u:row];}
