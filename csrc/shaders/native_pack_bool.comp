#version 450
layout(local_size_x=128) in;
layout(binding=0) readonly buffer Input {uint x[];};
layout(binding=1) writeonly buffer Output {uint y[];};
layout(push_constant) uniform Params {uint count,offset;uint sizes[8];uint strides[8];}p;
void main(){uint word=(gl_WorkGroupID.x+gl_WorkGroupID.y*gl_NumWorkGroups.x)*128+gl_LocalInvocationID.x;if(word>=(p.count/4+uint(p.count%4!=0)))return;uint result=0;
 for(uint b=0;b<4;b++){uint i=word*4+b;if(i>=p.count)break;uint t=i,off=p.offset;for(int d=7;d>=0;d--){off+=(t%p.sizes[d])*p.strides[d];t/=p.sizes[d];}result|=((x[off/4]>>(8*(off%4)))&255u)<<(8*b);}y[word]=result;}
