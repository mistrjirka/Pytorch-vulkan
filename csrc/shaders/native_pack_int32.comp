#version 450
layout(local_size_x=128) in;
layout(set=0,binding=0) readonly buffer Input { uint x[]; };
layout(set=0,binding=1) writeonly buffer Output { uint y[]; };
layout(push_constant) uniform Params { uint count,offset; uint dims[8]; uint strides[8]; } p;
void main() {
  uint i=(gl_WorkGroupID.x+gl_WorkGroupID.y*gl_NumWorkGroups.x)*128+gl_LocalInvocationID.x;
  if(i>=p.count)return;
  uint r=i,address=p.offset;
  for(int d=7;d>=0;--d){address+=(r%p.dims[d])*p.strides[d];r/=p.dims[d];}
  y[i]=x[address];
}
