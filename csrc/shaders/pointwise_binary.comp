}
float atan2_portable(float y,float x){uint xb=floatBitsToUint(x),yb=floatBitsToUint(y),ax=xb&0x7fffffffu,ay=yb&0x7fffffffu;bool xn=(xb&0x80000000u)!=0u,yn=(yb&0x80000000u)!=0u;float value;if(isnan(x)||isnan(y))return uintBitsToFloat(0x7fc00000u);if(ay==0u)value=xn?3.141592653589793:0.;else if(ax==0u)value=1.5707963267948966;else if(isinf(x)&&isinf(y))value=xn?2.356194490192345:.7853981633974483;else if(isinf(y))value=1.5707963267948966;else if(isinf(x))value=xn?3.141592653589793:0.;else {value=ay<=ax?portable_atan(divide_refined(uintBitsToFloat(ay),uintBitsToFloat(ax))):1.5707963267948966-portable_atan(divide_refined(uintBitsToFloat(ax),uintBitsToFloat(ay)));if(xn)value=3.141592653589793-value;}return yn?-value:value;}
float log1p_portable(float v){if(v< -1.)return uintBitsToFloat(0x7fc00000u);if(isinf(v))return v;float a=1.+v;if(a==1.)return v;return log(a)*divide_refined(v,a-1.);}
