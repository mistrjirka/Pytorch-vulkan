 else if(p.op==8)z=isnan(v)?v:x==0.?0.:x*log(v);
 else {if(isnan(x)||isnan(v))z=uintBitsToFloat(0x7fc00000u);else if(x==v)z=v;else if(x==0.)z=uintBitsToFloat((floatBitsToUint(v)&0x80000000u)|1u);else{uint bits=floatBitsToUint(x);bits+=(v>x)==(x>0.)?1u:0xffffffffu;z=uintBitsToFloat(bits);}}
 if(p.op!=2&&p.op!=5&&p.op!=8&&!(p.op==4&&(isinf(x)||isinf(v)))&&(isnan(x)||isnan(v)))z=uintBitsToFloat(0x7fc00000u);y[i]=z;}
