// Original FP32 arbitrary-axis sum/mean. One owner per output, no float atomics.
#version 450
layout(local_size_x=128) in;
layout(binding=0) readonly buffer Input {float x[];};
layout(binding=1) writeonly buffer Output {float y[];};
layout(push_constant) uniform Params {uint count,reduced,mask,mean,parallel;uint sizes[8];uint strides[8];} p;
shared float sums[128];
uint address(uint value,bool reduction){uint off=0;for(int d=7;d>=0;d--){if(((p.mask&(1u<<d))!=0)==reduction){off+=(value%p.sizes[d])*p.strides[d];value/=p.sizes[d];}}return off;}
void main(){uint group=gl_WorkGroupID.x+gl_WorkGroupID.y*gl_NumWorkGroups.x,lane=gl_LocalInvocationID.x;
 uint i=p.parallel!=0?group:group*128+lane;if(i>=p.count)return;
 uint base=address(i,false);float acc=0;
 for(uint k=p.parallel!=0?lane:0;k<p.reduced;k+=p.parallel!=0?128:1)acc+=x[base+address(k,true)];
 if(p.parallel!=0){sums[lane]=acc;barrier();for(uint s=64;s>0;s/=2){if(lane<s)sums[lane]+=sums[lane+s];barrier();}if(lane==0)y[i]=p.mean!=0?sums[0]/float(p.reduced):sums[0];}
 else y[i]=p.mean!=0?acc/float(p.reduced):acc;
}
