#version 450
layout(local_size_x=128) in;
layout(binding=0) readonly buffer X {float x[];};
layout(binding=1) writeonly buffer Y {float y[];};
layout(push_constant) uniform P {uint count,ins,outs,inner,scale,align,mode,backward;} p;
float filter_weight(float x){x=abs(x);if(p.mode==1)return max(0,1-x);float a=-.5;if(x<1)return ((a+2)*x-(a+3))*x*x+1;if(x<2)return ((a*x-5*a)*x+8*a)*x-4*a;return 0;}
float coefficient(uint i,uint o){float scale=uintBitsToFloat(p.scale);
 if(p.mode==0){float pos=p.align!=0?float(o)*scale:max(0,scale*(float(o)+.5)-.5);uint lo=min(uint(floor(pos)),p.ins-1),hi=min(lo+1,p.ins-1);float fraction=pos-float(lo);return (i==lo?1-fraction:0)+(i==hi?fraction:0);}
 float center=scale*(float(o)+.5),support=max(scale,1)*(p.mode==2?2:1),inv=1/max(scale,1);int lo=max(0,int(center-support+.5)),hi=min(int(p.ins),int(center+support+.5));if(int(i)<lo||int(i)>=hi)return 0;float denominator=0;for(int j=lo;j<hi;j++)denominator+=filter_weight((float(j)-center+.5)*inv);return denominator==0?0:filter_weight((float(i)-center+.5)*inv)/denominator;}
void main(){uint id=(gl_WorkGroupID.x+gl_WorkGroupID.y*gl_NumWorkGroups.x)*128+gl_LocalInvocationID.x;if(id>=p.count)return;uint axis=p.backward!=0?p.ins:p.outs,c=(id/p.inner)%axis,outer=id/(p.inner*axis),tail=id%p.inner;float sum=0;
 if(p.backward!=0){for(uint o=0;o<p.outs;o++){float w=coefficient(c,o);if(w!=0)sum+=w*x[(outer*p.outs+o)*p.inner+tail];}}
 else{float scale=uintBitsToFloat(p.scale);int lo,hi;if(p.mode==0){float pos=p.align!=0?float(c)*scale:max(0,scale*(float(c)+.5)-.5);lo=min(int(floor(pos)),int(p.ins)-1);hi=min(lo+2,int(p.ins));}else{float center=scale*(float(c)+.5),support=max(scale,1)*(p.mode==2?2:1);lo=max(0,int(center-support+.5));hi=min(int(p.ins),int(center+support+.5));}
 for(int i=lo;i<hi;i++)sum+=coefficient(uint(i),c)*x[(outer*p.ins+uint(i))*p.inner+tail];}y[id]=sum;}
