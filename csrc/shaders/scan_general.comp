#version 450
layout(local_size_x=128) in;
layout(binding=0) readonly buffer X {uint x[];};
layout(binding=1) writeonly buffer Y {uint y[];};
layout(binding=2) writeonly buffer I {uvec2 indices[];};
layout(push_constant) uniform P {uint rows,n,inner,type,mode;}p;
uvec2 plus64(uvec2 a,uvec2 b){uint lo=a.x+b.x;return uvec2(lo,a.y+b.y+uint(lo<a.x));}
uvec2 times64(uvec2 a,uvec2 b){uint hi,lo;umulExtended(a.x,b.x,hi,lo);return uvec2(lo,hi+a.x*b.y+a.y*b.x);}
uvec2 loadv(uint i){uint a=x[i*(p.type==2?2:1)];return uvec2(a,p.type==2?x[2*i+1]:(int(a)<0?0xffffffffu:0));}
bool less(uvec2 a,uvec2 b){return p.type==1?int(a.x)<int(b.x):a.y==b.y?a.x<b.x:int(a.y)<int(b.y);}
void main(){uint row=(gl_WorkGroupID.x+gl_WorkGroupID.y*gl_NumWorkGroups.x)*128+gl_LocalInvocationID.x;if(row>=p.rows)return;uint start=(row/p.inner)*p.n*p.inner+row%p.inner;uvec2 total=uvec2(p.mode==1?1:0,0);if(p.type==0)total.x=floatBitsToUint(p.mode==1?1.:0.);uint selected=0;
 for(uint j=0;j<p.n;j++){uint address=start+j*p.inner;uvec2 v=loadv(address);if(p.mode<2){if(p.type==0)total.x=floatBitsToUint(p.mode==0?uintBitsToFloat(total.x)+uintBitsToFloat(v.x):uintBitsToFloat(total.x)*uintBitsToFloat(v.x));else total=p.mode==0?plus64(total,v):times64(total,v);}
 else{bool better;if(p.type==0){float a=uintBitsToFloat(v.x),b=uintBitsToFloat(total.x);better=isnan(a)||(!isnan(b)&&(p.mode==2?a>=b:a<=b));}else better=p.mode==2?!less(v,total):!less(total,v);if(j==0||better){total=v;selected=j;}indices[address]=uvec2(selected,0);}
 if(p.type==2){y[2*address]=total.x;y[2*address+1]=total.y;}else y[address]=total.x;
 }}
