#version 450
layout(local_size_x=128) in;
layout(binding=0) readonly buffer I {uvec2 indices[];};
layout(binding=1) writeonly buffer F {float flags[];};
layout(push_constant) uniform P {uint nnz,sd,coalesced;uint sizes[8];} p;
shared uint bad;
void main(){uint group=gl_WorkGroupID.x+gl_WorkGroupID.y*gl_NumWorkGroups.x,lane=gl_LocalInvocationID.x;if(lane==0)bad=0;barrier();uint step=gl_NumWorkGroups.x*gl_NumWorkGroups.y*128;for(uint i=group*128+lane;i<p.nnz;i+=step){bool larger=false,decided=false;for(uint d=0;d<p.sd;d++){uvec2 index=indices[d*p.nnz+i];if(index.y!=0||index.x>=p.sizes[d])atomicOr(bad,1);if(i>0&&!decided){uvec2 previous=indices[d*p.nnz+i-1];if(index!=previous){larger=index.y>previous.y||(index.y==previous.y&&index.x>previous.x);decided=true;}}}if(p.coalesced!=0&&i>0&&!larger)atomicOr(bad,1);}barrier();if(lane==0)flags[group]=float(bad);}
