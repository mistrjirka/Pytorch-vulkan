#version 450
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer Forward { float forward_values[]; };
layout(set = 0, binding = 1) readonly buffer Grad { float grad_output[]; };
layout(set = 0, binding = 2) writeonly buffer Result { float grad_input[]; };

layout(push_constant) uniform Push {
    uint count;
    float threshold;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.count) {
        grad_input[i] = forward_values[i] <= pc.threshold ? 0.0 : grad_output[i];
    }
}
